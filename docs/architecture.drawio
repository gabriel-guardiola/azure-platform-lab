<mxfile host="app.diagrams.net"><diagram name="architecture"><mxGraphModel dx="1400" dy="920" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="920"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;azure-platform-lab: architecture (Nov 22)&lt;/b&gt;" style="text;html=1;fontSize=24;fontColor=#1F3A5F;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="800" height="35" as="geometry"/></mxCell><mxCell id="az" value="&lt;b&gt;Azure subscription (Azure for Students)&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F3F8FD;strokeColor=#2E6DB4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=14;fontColor=#2E6DB4;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="1050" height="410" as="geometry"/></mxCell><mxCell id="rg" value="&lt;b&gt;rg-gglab  (Terraform-managed, destroyed after each session)&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7FA7D6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=14;fontColor=#7FA7D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="345" y="340" width="640" height="295" as="geometry"/></mxCell><mxCell id="rgs" value="&lt;b&gt;rg-tfstate  (never destroyed)&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7FA7D6;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=14;fontColor=#7FA7D6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="340" width="335" height="295" as="geometry"/></mxCell><mxCell id="local" value="&lt;b&gt;Local: Docker Desktop on Mac&lt;/b&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#F6F6F6;strokeColor=#888888;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=14;fontColor=#888888;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1330" height="190" as="geometry"/></mxCell><mxCell id="mac" value="&lt;b&gt;Developer (Mac)&lt;/b&gt;&lt;br&gt;VS Co